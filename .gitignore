# macOS
.DS_Store

# Python virtual environments (CPU geometry, CPU DCT, GPU DCT)
.venv/
.venv-dct/
.venv-dct-gpu/

# Large activation files (regenerate with scripts/extract.py)
activations/

# DCT outputs (regenerate with run_dct_*.py / compare_directions.py)
dct_*.pt
dct_meta_*.json
compare_*.csv

# Funnel outputs (regenerate with the funnel scripts)
truth_dir_*.npz
interpret_top10_*.md
steer_supervised_*.md
steer_supervised_*.csv
plot_funnel_*.png
plot_findings_*.png
plot_judge_*.png
judge_steer_*.csv
judge_interpret_*.csv

# DCT outputs (binary vectors + metadata; regenerate with run_dct_*.py)
dct_V*.pt
dct_U*.pt
dct_meta_*.json

# MAG outputs (regenerate with mag/extract.py, run_mag.py, viz_mag.py)
mag_acts_*.npz

# Runtime logs
docs/*.log
*.log

# Personal cluster runbooks (contain account/login specifics)
deltaai/MY_RUN_STEPS.md
deltaai/MAG_EXTRACT_RUN.md
deltaai/MAG_E4_RUN.md
deltaai/FUNNEL_RUN_STEPS.md

# Master synthesis explainer (personal, kept local)
docs/MASTER_EXPLAINER.md

# Python cache
__pycache__/
*.pyc
judge_validation_*.csv

# Reachability audit: large cluster binaries (700 MB combined; regenerate per deltaai/REACH_RUN.md)
reach_acts_*.npz
reach_stemacts_*.npz
reach_margins_*.npz
reach_svd_*/

# Token-space program: large cluster binaries (regenerate per deltaai/TOKEN_SPACE_RUN.md)
token_acts_*.npz
token_geom_*.npz

# Stray SLURM stdout that was never a deliverable
ts_cc_redo_*.out

# SLURM job stdout: carries cluster usernames and paths; cited by job id in docs, kept local
*.out
logs/

# Byte-identical archive copies made by run_truthfulqa_stmt.slurm's stage 0
*.malformed-prompts.csv

# Blind hand-labelling answer key: stays out of git until the sheet is labelled
hand_labels_*_KEY_do_not_open_before_labelling.csv
